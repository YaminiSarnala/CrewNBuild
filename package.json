  "version": "1.0.0",
  "main": "index.js",
  "description": "OctaBuild — mobile app for Android & iOS (Expo)",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lan": "expo start --lan",
    "tunnel": "expo start --tunnel",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:all": "eas build --platform all --profile production"
